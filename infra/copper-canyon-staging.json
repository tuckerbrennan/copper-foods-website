{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Copper Foods static website hosted on a subdomain of higolounge.com.",
  "Parameters": {
    "PreviewDomain": {"Type": "String", "Default": "staging.coppercanyon.higolounge.com"},
    "RootDocument": {"Type": "String", "Default": "copper-canyon.html", "AllowedValues": ["copper-canyon.html", "index.html"]},
    "HostedZoneId": {"Type": "AWS::Route53::HostedZone::Id"},
    "ResponseHeadersPolicyId": {"Type": "String"}
  },
  "Resources": {
    "Site": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "VersioningConfiguration": {"Status": "Enabled"},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true}
      }
    },
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {"Ref": "PreviewDomain"},
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [{"DomainName": {"Ref": "PreviewDomain"}, "HostedZoneId": {"Ref": "HostedZoneId"}}]
      }
    },
    "Access": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {"Fn::Sub": "${AWS::StackName}-s3"},
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Aliases": [{"Ref": "PreviewDomain"}],
          "DefaultRootObject": {"Ref": "RootDocument"},
          "PriceClass": "PriceClass_100",
          "HttpVersion": "http2and3",
          "ViewerCertificate": {"AcmCertificateArn": {"Ref": "Certificate"}, "SslSupportMethod": "sni-only", "MinimumProtocolVersion": "TLSv1.2_2021"},
          "Origins": [{
            "Id": "site",
            "DomainName": {"Fn::GetAtt": ["Site", "RegionalDomainName"]},
            "OriginAccessControlId": {"Ref": "Access"},
            "S3OriginConfig": {"OriginAccessIdentity": ""}
          }],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": {"Ref": "ResponseHeadersPolicyId"}
          }
        }
      }
    },
    "SitePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "Site"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {"Sid": "DenyUnencryptedTransport", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["Site", "Arn"]}, {"Fn::Sub": "${Site.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": false}}},
            {"Sid": "ReadFromCloudFront", "Effect": "Allow", "Principal": {"Service": "cloudfront.amazonaws.com"}, "Action": "s3:GetObject", "Resource": {"Fn::Sub": "${Site.Arn}/*"}, "Condition": {"StringEquals": {"AWS:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}}}
          ]
        }
      }
    },
    "PreviewRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {"Ref": "HostedZoneId"},
        "Name": {"Ref": "PreviewDomain"},
        "Type": "CNAME",
        "TTL": "300",
        "ResourceRecords": [{"Fn::GetAtt": ["Distribution", "DomainName"]}]
      }
    }
  },
  "Outputs": {
    "BucketName": {"Value": {"Ref": "Site"}},
    "DistributionId": {"Value": {"Ref": "Distribution"}},
    "PreviewURL": {"Value": {"Fn::Sub": "https://${PreviewDomain}/"}}
  }
}
